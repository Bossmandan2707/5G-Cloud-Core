# macOS
.DS_Store

# Logs and ZIP archives
logs/
*.[lL][oO][gG]
*.[zZ][iI][pP]

# Explicitly archived project testing artifacts
!/testing/logs/
!/testing/logs/**
!/testing/Deployment.zip

# Local secrets / credentials
*.pem
*.key
.env
*.env
*.kubeconfig
kubeconfig*
# Private packet captures, including tcpdump rotation files
*.pcap
*.pcap[0-9]*
*.pcapng

# Python
__pycache__/
*.pyc
.venv/
