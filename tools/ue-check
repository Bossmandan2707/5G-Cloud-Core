#!/usr/bin/env python3
"""Check and recover saved UE, internet and IMS readiness; never dial."""
import os
from pathlib import Path
import sys

root = Path(__file__).resolve().parent.parent
python = root / ".venv/bin/python"
if not python.is_file():
    raise SystemExit("Project virtual environment missing; no environment changes attempted.")
if Path(sys.prefix).resolve() != (root / ".venv").resolve():
    os.execv(str(python), [str(python), str(Path(__file__).resolve()), *sys.argv[1:]])
sys.path.insert(0, str(root))
from ims.health_cli import main

raise SystemExit(main("ue"))
